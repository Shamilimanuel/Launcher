<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 11+ hides other apps from us unless we say which ones we need to see.
        This asks for "every app that has an icon in the app list" - exactly what a launcher shows.
    -->
    <!-- Weather: download the forecast from Open-Meteo, using only a rough (~10 km) location. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The event line under the date + the agenda pop-up: his next events. Asked only when he taps "Tap to show your events". -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Saved looks: applying a save can set its own wallpaper (a normal permission, no question). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- The vault: unlock with a fingerprint as well as the PIN (a normal permission, no question). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Stats card: the Wi-Fi signal strength (a normal permission, no question to him). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Search: find his contacts by name. Only asked for when he taps "allow access" in search. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Search commands "> timer 5m" and "> alarm 7:30": hand them to the phone's clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lets us show Android's "Uninstall this app?" dialog from the app menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Apps that offer home-screen widgets (for "Add from an app" in the widget stack). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Icon packs (like Darko) label themselves with one of these. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">
        <!--
            The home screen.
            singleTask + clearTaskOnLaunch: there is only ever one home, and pressing Home always lands on it.
            stateNotNeeded: Android may restart it freely without saving anything.
            excludeFromRecents: the home screen doesn't show up in the recent-apps list.
            portrait: the home stays upright when the phone is turned sideways, like Niagara (his note, 24 Oct).
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Launcher"
            android:windowSoftInputMode="adjustResize">
            <!-- Shows up in the app list (and lets Android Studio's Run button open it). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tells Android "I can be the Home screen". -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            "Seelie settings" (Serenitea): a window INSIDE Seelie, like Niagara's settings. No icon of its own
            (no LAUNCHER filter) and no task of its own, so it never shows up as a separate app or in recent apps.
            It lives on top of the home screen: Back closes it, and Home (singleTask) clears it away.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_name"
            android:theme="@style/Theme.Seelie.Settings" />
        <!--
            Seelie's notification listener: shows messages on his favourites (+ quick reply), the music card
            and the Quiet toggle. Only works after he switches on "Notification access" for Seelie; stays on the phone.
        -->
        <!-- "Add to home screen" from a browser or app: Seelie asks, then keeps it as a favourite. -->
        <activity
            android:name=".apps.PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- One-off Niagara import, sent over adb only (DUMP is a shell/system-only permission). -->
        <receiver
            android:name=".apps.NiagaraImport"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
            Seelie's volume buttons: an Accessibility service that ONLY hears the + / - keys (no screen content, no
            events) and shows Seelie's side bar instead of the phone's. Works after he switches it on under
            Accessibility; with the screen off, in calls or while ringing the phone's own volume stays.
        -->
        <service
            android:name=".volume.SeelieVolumeService"
            android:exported="false"
            android:label="@string/volume_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/seelie_volume_service" />
        </service>

        <service
            android:name=".notify.SeelieNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
